62f 3 \u7684\u500d\u6570\uff0c\u662f\u5e78\u8fd0\u53f7\u7801\u3002   \u5171 2 \u4e2a\u3002</p> </li> </ul>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E5%B9%B8%E8%BF%90%E5%8F%B7%E7%A0%81%EF%BC%88lucky%EF%BC%89/#_3","title":"\u3010\u6570\u636e\u8303\u56f4\u3011","text":"<p>\u5bf9\u4e8e\u6240\u6709\u6d4b\u8bd5\u6570\u636e\uff0c\u4fdd\u8bc1\uff1a$1\u2264L\u2264R\u226410^6$\u3002</p> \u6d4b\u8bd5\u70b9 $R$ \u7279\u6b8a\u6027\u8d28 $1\u223c3$ $\\leq 10^3$ \u65e0\u7279\u6b8a\u6027\u8d28 $4\u223c6$ $\\leq 10^5$ \u65e0\u7279\u6b8a\u6027\u8d28 $7\u223c8$ $\\leq 10^6$ $L=1$ $9\u223c10$ $\\leq 10^6$ \u65e0\u7279\u6b8a\u6027\u8d28"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E5%B9%B8%E8%BF%90%E5%8F%B7%E7%A0%81%EF%BC%88lucky%EF%BC%89/#_4","title":"\u3010\u9898\u89e3\u3011","text":"<p>\u89c2\u5bdf\u53ef\u5f97\uff0c$R_{max} \\leq 10^6$ \uff0c\u56e0\u6b64\u6211\u4eec\u53ef\u4ee5\u5c06\u65f6\u95f4\u590d\u6742\u5ea6\u7ef4\u6301\u5728 $O(n)$ \u5de6\u53f3\u5373\u53ef\u3002</p> <p>\u6839\u636e\u9898\u610f\uff0c\u672c\u9898\u9700\u8981\u4f7f\u7528\u6570\u4f4d\u62c6\u5206\uff0c\u6570\u4f4d\u62c6\u5206\u7684\u590d\u6742\u5ea6\u662f $O(\\log_{10}n)$ \u3002</p> <p>\u56e0\u6b64\u6700\u4f18\u65f6\u95f4\u590d\u6742\u5ea6\u4e3a $O(n \u00b7 \\log_{10}n)$\u3002</p> <p>\u4ee3\u7801\u5982\u4e0b\uff1a</p> <pre><code>#include&lt;bits/stdc++.h&gt;\n#define ll long long\nusing namespace std;\nint main(){\n    freopen(\"lucky.in\",\"r\",stdin);\n    freopen(\"lucky.out\",\"w\",stdout);\n    ios::sync_with_stdio(0);\n    cin.tie(0);\n    cout.tie(0);\n    int L,R;\n    cin&gt;&gt;L&gt;&gt;R;\n    ll ans=0;\n    for(int i=L;i&lt;=R;i++){\n        int temp=i;\n        bool f=0;\n        while(temp){\n            if(temp%10==4){\n                f=1;\n                break;\n            }\n            temp/=10;\n        }\n        if(!f){\n            ans++;\n        }\n    }\n    cout&lt;&lt;ans&lt;&lt;endl;\n    return 0;\n} \n</code></pre>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E5%BA%8F%E5%88%97%EF%BC%88seq%EF%BC%89/","title":"\u5e8f\u5217\uff08seq\uff09\u9898\u89e3","text":""},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E5%BA%8F%E5%88%97%EF%BC%88seq%EF%BC%89/#_1","title":"\u9898\u76ee\u63cf\u8ff0","text":"<p>\u5c0f L \u6b63\u5728\u8fdb\u884c\u4e00\u9879\u5173\u4e8e\u5e8f\u5217\u7684\u6570\u5b66\u7814\u7a76\u3002</p> <p>\u4ed6\u60f3\u8ba9\u4f60\u6784\u9020\u4e00\u4e2a\u6b63\u6574\u6570\u5e8f\u5217 $a$\uff0c\u8981\u6c42\u6ee1\u8db3\u4ee5\u4e0b\u6761\u4ef6\uff1a</p> <ul> <li>\u8fd9\u4e2a\u5e8f\u5217\u5171\u6709 $n$ \u4e2a\u6570\uff0c\u4e0b\u6807\u4ece $1$ \u5230 $n$\u3002</li> <li>\u5e8f\u5217\u6240\u6709\u5143\u7d20\u7684\u548c\u6070\u597d\u4e3a $m$\uff0c\u5373 $\\sum_{i=1}^{n} a_i = m$\u3002</li> <li>\u5728\u6ee1\u8db3\u4e0a\u8ff0\u6761\u4ef6\u7684\u524d\u63d0\u4e0b\uff0c\u8bf7\u4f60\u6c42\u51fa\u4e0b\u9762\u8fd9\u4e2a\u5f0f\u5b50\u7684\u6700\u5927\u503c\uff1a</li> </ul> \\[ \\sum_{i=1}^{n} (a_i \\bmod k) \\]"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E5%BA%8F%E5%88%97%EF%BC%88seq%EF%BC%89/#_2","title":"\u8f93\u5165\u683c\u5f0f","text":"<p>\u4ece\u6587\u4ef6 $seq.in$ \u4e2d\u8bfb\u5165\u6570\u636e\u3002</p> <p>\u672c\u9898\u6709\u591a\u7ec4\u6570\u636e\u3002</p> <p>\u7b2c\u4e00\u884c\u8f93\u5165\u4e00\u4e2a\u6574\u6570 $T$\uff0c\u8868\u793a\u6d4b\u8bd5\u6570\u636e\u7ec4\u6570\uff0c\u5bf9\u4e8e\u6bcf\u4e00\u7ec4\u6570\u636e\uff1a</p> <p>\u8f93\u5165\u5305\u542b $3$ \u4e2a\u6b63\u6574\u6570 $n,m,k$\uff0c\u76f8\u90bb\u6574\u6570\u4e4b\u95f4\u4ee5\u5355\u4e2a\u7a7a\u683c\u5206\u9694\u3002</p>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E5%BA%8F%E5%88%97%EF%BC%88seq%EF%BC%89/#_3","title":"\u8f93\u51fa\u683c\u5f0f","text":"<p>\u8f93\u51fa\u5230\u6587\u4ef6 $seq.out$ \u4e2d\u3002</p> <p>\u5bf9\u4e8e\u6bcf\u4e00\u7ec4\u6570\u636e\uff1a</p> <p>\u8f93\u51fa\u4e00\u884c\u5305\u542b\u4e00\u4e2a\u6574\u6570\uff0c\u8868\u793a\u9898\u76ee\u8981\u6c42\u7684\u6700\u5927\u503c\u3002</p>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E5%BA%8F%E5%88%97%EF%BC%88seq%EF%BC%89/#1","title":"\u8f93\u5165\u6570\u636e 1","text":"<pre><code>2\n3 5 3\n3 11 3\n</code></pre>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E5%BA%8F%E5%88%97%EF%BC%88seq%EF%BC%89/#1_1","title":"\u8f93\u51fa\u6570\u636e 1","text":"<pre><code>5\n5\n</code></pre>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E5%BA%8F%E5%88%97%EF%BC%88seq%EF%BC%89/#1_2","title":"\u6837\u4f8b 1 \u89e3\u91ca","text":"<p>\u5bf9\u4e8e\u7b2c\u4e00\u7ec4\u6570\u636e\uff0c\u53ef\u6784\u9020\u51fa\u5e8f\u5217 a=[2,1,2]\uff0c\u5bf9\u5176\u5206\u522b\u53d6\u6a21\u540e\u6c42\u548c\u4e3a (2mod3)+(1mod3)+(2mod3)=5\uff0c\u53ef\u4ee5\u8bc1\u660e\u8fd9\u662f\u80fd\u83b7\u5f97\u7684\u6700\u5927\u503c\u3002</p>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E5%BA%8F%E5%88%97%EF%BC%88seq%EF%BC%89/#2","title":"\u6837\u4f8b 2","text":"<p>\u89c1\u9009\u624b\u76ee\u5f55\u4e0b\u7684 <code>seq/seq2.in</code> \u4e0e <code>seq/seq2.ans</code>\u3002</p>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E5%BA%8F%E5%88%97%EF%BC%88seq%EF%BC%89/#3","title":"\u6837\u4f8b 3","text":"<p>\u89c1\u9009\u624b\u76ee\u5f55\u4e0b\u7684 <code>seq/seq3.in</code> \u4e0e <code>seq/seq3.ans</code>\u3002</p>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E5%BA%8F%E5%88%97%EF%BC%88seq%EF%BC%89/#4","title":"\u6837\u4f8b 4","text":"<p>\u89c1\u9009\u624b\u76ee\u5f55\u4e0b\u7684 <code>seq/seq4.in</code> \u4e0e <code>seq/seq4.ans</code>\u3002</p>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E5%BA%8F%E5%88%97%EF%BC%88seq%EF%BC%89/#_4","title":"\u6570\u636e\u8303\u56f4","text":"<p>\u5bf9\u4e8e\u6240\u6709\u6d4b\u8bd5\u6570\u636e\uff0c\u4fdd\u8bc1\uff1a</p> <ul> <li>$1\u2264T\u226410^5$\uff1b</li> <li>$2\u2264n\u2264k\u226410^9$\uff1b</li> <li>$n\u2264m\u226410^{18}$\u3002</li> </ul> \u6d4b\u8bd5\u70b9\u7f16\u53f7 \u5206\u503c $T \\le$ \u7279\u6b8a\u9650\u5236 1 10 10 $k \\le 8,\\ m \\le 30$ 2 10 100 $k \\le 30,\\ m \\le 500$ 3 10 $10^4$ $\\sum n \\le 2 \\times 10^5$ 4 10 $10^5$ \u5bf9\u6240\u6709\u8be2\u95ee\u5747\u6709 $m \\le n(k-1)$ 5 10 $10^4$ $\\sum k \\le 2 \\times 10^6$ 6 10 $10^3$ \u65e0 7 10 $10^5$ \u65e0 8 10 $10^5$ \u65e0 9 10 $10^5$ \u65e0 10 10 $10^5$ \u65e0"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E5%BA%8F%E5%88%97%EF%BC%88seq%EF%BC%89/#_5","title":"\u9898\u89e3","text":""},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E5%BA%8F%E5%88%97%EF%BC%88seq%EF%BC%89/#_6","title":"\u9898\u89e3","text":""},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E5%BA%8F%E5%88%97%EF%BC%88seq%EF%BC%89/#_7","title":"\u6838\u5fc3\u7ed3\u8bba","text":"<p>\u7b54\u6848\u5206\u4e24\u79cd\u60c5\u51b5\uff1a</p> <p>\u60c5\u51b5 1\uff1a$m \\le n(k-1)$</p> <p>\u53ef\u4ee5\u8ba9\u6bcf\u4e2a $a_i$ \u90fd\u5c0f\u4e8e $k$\uff0c\u6b64\u65f6 $a_i \\bmod k = a_i$\uff0c\u6240\u4ee5\uff1a</p> \\[ \\text{ans} = m \\] <p>\u60c5\u51b5 2\uff1a$m &gt; n(k-1)$</p> <p>\u8ba9\u524d $n-1$ \u4e2a\u6570\u90fd\u53d6 $k-1$\uff08\u53d6\u6a21\u6700\u5927\uff09\uff0c\u6700\u540e\u4e00\u4e2a\u6570\u62ff\u8d70\u5269\u4e0b\u7684\u3002\u8bbe\u5269\u4f59\u4e3a $S = m - (n-1)(k-1)$\uff0c\u5219\uff1a</p> \\[ \\text{ans} = (n-1)(k-1) + (S \\bmod k) \\] <p>\u4ee3\u7801\u5982\u4e0b\uff1a</p> <pre><code>#include&lt;bits/stdc++.h&gt;\n#define ll long long\nusing namespace std;\nint main(){\n    freopen(\"seq.in\",\"r\",stdin);\n    freopen(\"seq.out\",\"w\",stdout);\n    ios::sync_with_stdio(0);\n    cin.tie(0);\n    cout.tie(0);\n    ll T,n,m,k;\n    cin&gt;&gt;T;\n    for(int i=1;i&lt;=T;i++){\n        cin&gt;&gt;n&gt;&gt;m&gt;&gt;k;\n        if(m&lt;=n*(k-1)) cout&lt;&lt;m&lt;&lt;'\\n';\n        else cout&lt;&lt;(n-1)*(k-1)+((m-(n-1)*(k-1))%k)&lt;&lt;'\\n';\n    } \n    return 0;\n}\n</code></pre>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E8%87%AA%E5%8A%A8%E5%94%AE%E8%B4%A7%E6%9C%BA%EF%BC%88vending%EF%BC%89/","title":"\u81ea\u52a8\u552e\u8d27\u673a\uff08vending\uff09\u9898\u89e3","text":""},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E8%87%AA%E5%8A%A8%E5%94%AE%E8%B4%A7%E6%9C%BA%EF%BC%88vending%EF%BC%89/#_1","title":"\u9898\u76ee\u63cf\u8ff0","text":"<p>\u5c0f T \u6765\u5230\u4e86\u5b66\u6821\u65b0\u5efa\u7684\u5168\u81ea\u52a8\u65e0\u4eba\u4fbf\u5229\u5e97\u3002\u4fbf\u5229\u5e97\u7684\u652f\u4ed8\u7cfb\u7edf\u652f\u6301\u4e24\u79cd\u4ee3\u5e01\uff1a\u666e\u901a\u5e01\uff08\u9762\u503c $1$ \u5143\uff09\u548c\u9ad8\u7ea7\u5e01\uff08\u9762\u503c $K$ \u5143\uff09\u3002</p> <p>\u4fbf\u5229\u5e97\u5185\u6709\u4e24\u53f0\u552e\u8d27\u673a\uff1a\u4e00\u53f0\u662f\u96f6\u98df\u552e\u8d27\u673a\uff0c\u51fa\u552e $n$ \u79cd\u96f6\u98df\uff1b\u53e6\u4e00\u53f0\u662f\u996e\u6599\u552e\u8d27\u673a\uff0c\u51fa\u552e $m$ \u79cd\u996e\u6599\u3002\u96f6\u98df\u7684\u7f16\u53f7\u4e3a $1 \\sim n$\uff0c\u996e\u6599\u7684\u7f16\u53f7\u4e3a $1 \\sim m$\u3002</p> <p>\u7b2c $i$ \u79cd\u96f6\u98df\u7684\u4ef7\u683c\u4e3a $A_i$ \u5143\uff0c\u7b2c $j$ \u79cd\u996e\u6599\u7684\u4ef7\u683c\u4e3a $B_j$ \u5143\u3002</p> <p>\u5728\u652f\u4ed8\u89c4\u5219\u4e0a\uff0c\u8fd9\u4e24\u53f0\u673a\u5668\u6709\u6240\u4e0d\u540c\uff1a</p> <ul> <li>\u96f6\u98df\u552e\u8d27\u673a\u540c\u65f6\u63a5\u53d7\u666e\u901a\u5e01\u548c\u9ad8\u7ea7\u5e01\u7684\u6df7\u5408\u652f\u4ed8\u3002</li> <li>\u996e\u6599\u552e\u8d27\u673a\u53ea\u63a5\u53d7\u9ad8\u7ea7\u5e01\u652f\u4ed8\u3002</li> </ul> <p>\u4e24\u53f0\u552e\u8d27\u673a\u7684\u627e\u96f6\u673a\u5236\u76f8\u540c\uff1a\u6240\u6709\u7684\u627e\u96f6\u5747\u4f7f\u7528\u666e\u901a\u5e01\uff08\u9762\u503c $1$ \u5143\uff09\u9000\u8fd8\u7ed9\u4e70\u5bb6\u3002</p> <p>\u6bcf\u79cd\u7279\u5b9a\u7684\u96f6\u98df\u6216\u996e\u6599\uff0c\u6700\u591a\u53ea\u80fd\u8d2d\u4e70\u4e00\u4ef6\u3002</p> <p>\u5c0f T \u73b0\u5728\u53e3\u888b\u91cc\u6709 $X$ \u679a\u666e\u901a\u5e01\u548c $Y$ \u679a\u9ad8\u7ea7\u5e01\u3002\u4ed6\u5e0c\u671b\u7528\u624b\u5934\u7684\u8fd9\u4e9b\u4ee3\u5e01\u8d2d\u4e70\u5c3d\u53ef\u80fd\u591a\u7684\u5546\u54c1\u3002</p> <p>\u8bf7\u4f60\u5e2e\u5c0f T \u8ba1\u7b97\u4e00\u4e0b\uff0c\u5728\u6700\u4f18\u7684\u8d2d\u4e70\u7b56\u7565\u4e0b\uff0c\u4ed6\u6700\u591a\u80fd\u4e70\u5230\u591a\u5c11\u4ef6\u5546\u54c1\uff1f</p>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E8%87%AA%E5%8A%A8%E5%94%AE%E8%B4%A7%E6%9C%BA%EF%BC%88vending%EF%BC%89/#_2","title":"\u8f93\u5165\u683c\u5f0f","text":"<p>\u4ece\u6587\u4ef6 $vending.in$ \u4e2d\u8bfb\u5165\u6570\u636e\u3002</p> <p>\u7b2c\u4e00\u884c\u5305\u542b\u4e09\u4e2a\u6b63\u6574\u6570 $n,m,K$\uff0c\u5206\u522b\u8868\u793a\u96f6\u98df\u7684\u79cd\u7c7b\u6570\u3001\u996e\u6599\u7684\u79cd\u7c7b\u6570\u4ee5\u53ca\u9ad8\u7ea7\u5e01\u7684\u9762\u503c\u3002</p> <p>\u7b2c\u4e8c\u884c\u5305\u542b\u4e24\u4e2a\u975e\u8d1f\u6574\u6570 $X,Y$\uff0c\u5206\u522b\u8868\u793a\u5c0f T \u62e5\u6709\u7684\u666e\u901a\u5e01\u6570\u91cf\u548c\u9ad8\u7ea7\u5e01\u6570\u91cf\u3002</p> <p>\u7b2c\u4e09\u884c\u5305\u542b $n$ \u4e2a\u6b63\u6574\u6570 $A_1,A_2,\\dots,A_n$\uff0c\u8868\u793a\u5404\u96f6\u98df\u7684\u4ef7\u683c\u3002</p> <p>\u7b2c\u56db\u884c\u5305\u542b $m$ \u4e2a\u6b63\u6574\u6570 $B_1,B_2,\\dots,B_m$\uff0c\u8868