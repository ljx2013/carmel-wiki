{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u5173\u4e8e\u672c\u7ad9","text":"<p>\u672c\u7ad9\u4e3a\u6211\u4e2a\u4eba\u7684\u6d1b\u8c37\u9898\u76ee\u9898\u89e3\uff0c\u5e76\u4e14\u6709\u4e00\u4e9b\u57fa\u7840\u7684\u6559\u7a0b\uff0c\u5e0c\u671b\u53ef\u4ee5\u5e2e\u65b0\u624bOIer\u5feb\u901f\u5165\u95e8\u3002</p>"},{"location":"%E7%AC%94%E8%AE%B0/freopen%E7%9A%84%E4%BD%BF%E7%94%A8/","title":"<code>freopen()</code>\u7684\u4f7f\u7528","text":""},{"location":"%E7%AC%94%E8%AE%B0/freopen%E7%9A%84%E4%BD%BF%E7%94%A8/#_1","title":"\u7b80\u4ecb","text":"<p><code>freopen()</code>\u662f\u4e00\u79cd\u6587\u4ef6\u8bfb\u5199\u51fd\u6570\uff0c\u4e3b\u8981\u7528\u4e8eCSP-J/S\u6bd4\u8d5b\uff0c\u672c\u6587\u5c06\u4ecb\u7ecd<code>freopen()</code>\u51fd\u6570\u7684\u4f7f\u7528\u65b9\u6cd5\uff0c\u5e2e\u52a9\u65b0\u624bOIer\u907f\u514d\u56e0\u4e3a\u6587\u4ef6I/O\u683c\u5f0f\u9519\u8bef\u800c\u7206\u96f6\u3002</p>"},{"location":"%E7%AC%94%E8%AE%B0/freopen%E7%9A%84%E4%BD%BF%E7%94%A8/#_2","title":"\u4f7f\u7528\u65b9\u6cd5","text":"<p><code>freopen()</code>\u4e3b\u8981\u7684\u4f7f\u7528\u683c\u5f0f\u662f\uff1a<code>freopen(\u6587\u4ef6\u540d(\u5305\u542b\u540e\u7f00\u540d),\u6a21\u5f0f(r/w),\u5176\u4ed6)</code>\u3002</p> <p>\u4f8b\u5982\u4e00\u4f4d\u9009\u624b\u9700\u8981\u8bfb\u5165<code>apple.in</code>\u4e2d\u7684\u6570\u636e\uff0c\u8f93\u51fa\u5230<code>apple.out</code>\u3002</p> <p>\u90a3\u4e48Ta\u5c31\u53ef\u4ee5\u8fd9\u4e48\u5199\uff1a</p> <pre><code>freopen(\"apple.in\",\"r\",stdin);\nfreopen(\"apple.out\",\"w\",stdout);\n</code></pre> <p>\u5176\u4e2d\uff1a</p> <p><code>apple.in</code>\u4e0e<code>apple.out</code>\u5206\u522b\u8868\u793a\u9700\u8981\u8bfb\u5165\u4e0e\u8f93\u51fa\u7684\u6587\u4ef6\u540d\u3002</p> <p>$\\textbf{\u6ce8\u610f\uff1a\u5982\u679c\u6587\u4ef6\u5939\u4e2d\u6ca1\u6709\u9700\u8981\u8bfb\u5165\u7684\u6587\u4ef6\uff0c\u5219\u4f1a\u62a5\u9519\u3002}$</p> <p><code>r</code>\u8868\u793a\u8bfb\u5165\u6a21\u5f0f\uff0c\u662f<code>read</code>\u7684\u7f29\u5199\uff1b<code>w</code>\u8868\u793a\u8bfb\u51fa\u6a21\u5f0f\uff0c\u662f<code>write</code>\u7684\u7f29\u5199\uff1b</p> <p><code>stdin</code>\u4e0e<code>stdout</code>\u5206\u522b\u662f\u8bfb\u5165\u4e0e\u8f93\u51fa\u9700\u8981\u7684\u914d\u7f6e\uff0c\u8fd9\u91cc\u4e0d\u9700\u8981\u7ba1\uff0c\u5199\u4e0a\u5c31\u53ef\u4ee5\u4e86\u3002</p> <p>\u6ce8\u610f\uff0c<code>freopen()</code>\u9700\u8981\u5199\u5728\u5173\u95ed\u8f93\u5165\u8f93\u51fa\u6d41\u7684\u524d\u9762\uff0c\u4e5f\u5c31\u662f\u4e3b\u51fd\u6570\u7684\u7b2c\u4e00\u884c\uff0c\u8fd8\u662f\u4ee5apple\u4e3e\u4f8b\uff0c\u5c31\u50cf\u8fd9\u6837\uff1a</p> <pre><code>#include&lt;bits/stdc++.h&gt;\nusing namespace std;\nint main(){\n    freopen(\"apple.in\",\"r\",stdin);\n    freopen(\"apple.out\",\"w\",stdout);\n    ios::sync_with_stdio(0);\n    cin.tie(0);\n    cout.tie(0);\n    //\u4f60\u7684\u4ee3\u7801\n    return 0;\n}\n</code></pre> <p>\u672c\u6587\u8f83\u77ed\uff0c\u82e5\u6709\u95ee\u9898\u8bf7\u5230Issue\u63d0\u4ea4\uff0c\u611f\u8c22\u5404\u4f4d\u6307\u6559\uff01</p>"},{"location":"%E7%AC%94%E8%AE%B0/%E5%85%B3%E9%97%AD%E8%BE%93%E5%85%A5%E8%BE%93%E5%87%BA%E6%B5%81/","title":"\u5173\u95ed\u8f93\u5165\u8f93\u51fa\u6d41","text":""},{"location":"%E7%AC%94%E8%AE%B0/%E5%85%B3%E9%97%AD%E8%BE%93%E5%85%A5%E8%BE%93%E5%87%BA%E6%B5%81/#_2","title":"\u4ecb\u7ecd","text":"<p>\u5728CSP-J/S\u7b49\u7ade\u8d5b\u4e2d\uff0c\u65f6\u95f4\u9650\u5236\u662f\u6781\u4e3a\u4e25\u683c\u7684\u3002\u56e0\u6b64\uff0c\u9009\u624b\u4e0d\u4ec5\u9700\u8981\u6ce8\u610f\u4ee3\u7801\u7684\u65f6\u95f4\u590d\u6742\u5ea6\uff0c\u8fd8\u9700\u8981\u6ce8\u610f\u7a0b\u5e8f\u7684\u8bfb\u5165\u8f93\u51fa\u6548\u7387\u3002</p> <p>\u6709\u65f6\uff0c\u4f60\u4f1a\u53d1\u73b0<code>cin</code>\u4e0e<code>cout</code>\u7684\u6548\u7387\u592a\u4f4e\uff0c\u5927\u90e8\u5206\u539f\u56e0\u662f\u56e0\u4e3a\u8f93\u5165\u8f93\u51fa\u7684\u540c\u6b65\u6d41\u6ca1\u6709\u5173\u95ed\uff0c\u56e0\u6b64\u624d\u9020\u6210\u4e86<code>TLE</code>\u3002</p> <p>\u6240\u4ee5\u6211\u5728\u8fd9\u91cc\u63d0\u4f9b\u4e24\u79cd\u89e3\u51b3\u65b9\u6848\uff1a</p> <ol> <li> <p>\u5173\u95ed\u8f93\u5165\u8f93\u51fa\u6d41\u3002</p> </li> <li> <p>\u4f7f\u7528<code>scanf</code>\u6216<code>printf</code>\u3002</p> </li> </ol> <p>\u5728\u67d0\u4e9b\u7279\u6b8a\u60c5\u51b5\u4e0b\uff0c\u5173\u95ed\u8f93\u5165\u8f93\u51fa\u6d41\u4f1a\u8f83\u5feb\u4e8e<code>scanf</code>\u4e0e<code>printf</code>\u3002</p> <p>\u4eca\u5929\u6211\u4eec\u5148\u4ecb\u7ecd\u7b2c1\u79cd\u65b9\u6cd5\u3002</p>"},{"location":"%E7%AC%94%E8%AE%B0/%E5%85%B3%E9%97%AD%E8%BE%93%E5%85%A5%E8%BE%93%E5%87%BA%E6%B5%81/#_3","title":"\u4f7f\u7528\u65b9\u6cd5","text":"<p>\u5173\u95ed\u8f93\u5165\u8f93\u51fa\u6d41\u5171\u6709\u4e24\u90e8\u5206\u7ec4\u6210\uff1a</p> <ol> <li> <p><code>ios::sync_with_stdio(0)</code></p> </li> <li> <p><code>cin.tie(0)</code>\u4e0e<code>cout.tie(0)</code></p> </li> </ol> <p>\u4e24\u90e8\u5206\u7684\u4f4d\u7f6e\u5728\u4e3b\u51fd\u6570\u4e2d\u4ec5\u6b21\u4e8e<code>freopen()</code>\u7684\u4f4d\u7f6e\uff0c\u6211\u4eec\u62ffA+B Problem\u4e3e\u4f8b\uff1a</p> <pre><code>#include&lt;bits/stdc++.h&gt;\nusing namespace std;\nint main(){\n    freopen(\"xxx.in\",\"r\",stdin);\n    freopen(\"xxx.out\",\"w\",stdout);\n    ios::sync_with_stdio(0);\n    cin.tie(0);\n    cout.tie(0);\n    //\u4f60\u7684\u4ee3\u7801\n    return 0;\n}\n</code></pre> <p>\u5173\u4e8e<code>freopen()</code>\u7684\u4ecb\u7ecd\u8bf7\u770b\u8fd9\u7bc7\u6587\u7ae0</p> <p>\u672c\u6587\u8f83\u77ed\uff0c\u82e5\u6709\u95ee\u9898\u8bf7\u5230Issue\u63d0\u4ea4\uff0c\u611f\u8c22\u5404\u4f4d\u6307\u6559\uff01</p>"}]}