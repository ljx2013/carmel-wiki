{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u5173\u4e8e\u672c\u7ad9","text":"<p>\u672c\u7ad9\u4e3a\u6211\u4e2a\u4eba\u7684\u6d1b\u8c37\u9898\u76ee\u9898\u89e3\uff0c\u5e76\u4e14\u6709\u4e00\u4e9b\u57fa\u7840\u7684\u6559\u7a0b\uff0c\u5e0c\u671b\u53ef\u4ee5\u5e2e\u65b0\u624bOIer\u5feb\u901f\u5165\u95e8\u3002</p>"},{"location":"%E7%AC%94%E8%AE%B0/%E5%89%8D%E7%BD%AE%E7%9F%A5%E8%AF%86/freopen%E7%9A%84%E4%BD%BF%E7%94%A8/","title":"<code>freopen()</code>\u7684\u4f7f\u7528","text":""},{"location":"%E7%AC%94%E8%AE%B0/%E5%89%8D%E7%BD%AE%E7%9F%A5%E8%AF%86/freopen%E7%9A%84%E4%BD%BF%E7%94%A8/#_1","title":"\u7b80\u4ecb","text":"<p><code>freopen()</code>\u662f\u4e00\u79cd\u6587\u4ef6\u8bfb\u5199\u51fd\u6570\uff0c\u4e3b\u8981\u7528\u4e8eCSP-J/S\u6bd4\u8d5b\uff0c\u672c\u6587\u5c06\u4ecb\u7ecd<code>freopen()</code>\u51fd\u6570\u7684\u4f7f\u7528\u65b9\u6cd5\uff0c\u5e2e\u52a9\u65b0\u624bOIer\u907f\u514d\u56e0\u4e3a\u6587\u4ef6I/O\u683c\u5f0f\u9519\u8bef\u800c\u7206\u96f6\u3002</p>"},{"location":"%E7%AC%94%E8%AE%B0/%E5%89%8D%E7%BD%AE%E7%9F%A5%E8%AF%86/freopen%E7%9A%84%E4%BD%BF%E7%94%A8/#_2","title":"\u4f7f\u7528\u65b9\u6cd5","text":"<p><code>freopen()</code>\u4e3b\u8981\u7684\u4f7f\u7528\u683c\u5f0f\u662f\uff1a<code>freopen(\u6587\u4ef6\u540d(\u5305\u542b\u540e\u7f00\u540d),\u6a21\u5f0f(r/w),\u5176\u4ed6)</code>\u3002</p> <p>\u4f8b\u5982\u4e00\u4f4d\u9009\u624b\u9700\u8981\u8bfb\u5165<code>apple.in</code>\u4e2d\u7684\u6570\u636e\uff0c\u8f93\u51fa\u5230<code>apple.out</code>\u3002</p> <p>\u90a3\u4e48Ta\u5c31\u53ef\u4ee5\u8fd9\u4e48\u5199\uff1a</p> <pre><code>freopen(\"apple.in\",\"r\",stdin);\nfreopen(\"apple.out\",\"w\",stdout);\n</code></pre> <p>\u5176\u4e2d\uff1a</p> <p><code>apple.in</code>\u4e0e<code>apple.out</code>\u5206\u522b\u8868\u793a\u9700\u8981\u8bfb\u5165\u4e0e\u8f93\u51fa\u7684\u6587\u4ef6\u540d\u3002</p> <p>$\\textbf{\u6ce8\u610f\uff1a\u5982\u679c\u6587\u4ef6\u5939\u4e2d\u6ca1\u6709\u9700\u8981\u8bfb\u5165\u7684\u6587\u4ef6\uff0c\u5219\u4f1a\u62a5\u9519\u3002}$</p> <p><code>r</code>\u8868\u793a\u8bfb\u5165\u6a21\u5f0f\uff0c\u662f<code>read</code>\u7684\u7f29\u5199\uff1b<code>w</code>\u8868\u793a\u8bfb\u51fa\u6a21\u5f0f\uff0c\u662f<code>write</code>\u7684\u7f29\u5199\uff1b</p> <p><code>stdin</code>\u4e0e<code>stdout</code>\u5206\u522b\u662f\u8bfb\u5165\u4e0e\u8f93\u51fa\u9700\u8981\u7684\u914d\u7f6e\uff0c\u8fd9\u91cc\u4e0d\u9700\u8981\u7ba1\uff0c\u5199\u4e0a\u5c31\u53ef\u4ee5\u4e86\u3002</p> <p>\u6ce8\u610f\uff0c<code>freopen()</code>\u9700\u8981\u5199\u5728\u5173\u95ed\u8f93\u5165\u8f93\u51fa\u6d41\u7684\u524d\u9762\uff0c\u4e5f\u5c31\u662f\u4e3b\u51fd\u6570\u7684\u7b2c\u4e00\u884c\uff0c\u8fd8\u662f\u4ee5apple\u4e3e\u4f8b\uff0c\u5c31\u50cf\u8fd9\u6837\uff1a</p> <pre><code>#include&lt;bits/stdc++.h&gt;\nusing namespace std;\nint main(){\n    freopen(\"apple.in\",\"r\",stdin);\n    freopen(\"apple.out\",\"w\",stdout);\n    ios::sync_with_stdio(0);\n    cin.tie(0);\n    cout.tie(0);\n    //\u4f60\u7684\u4ee3\u7801\n    return 0;\n}\n</code></pre> <p>\u672c\u6587\u8f83\u77ed\uff0c\u82e5\u6709\u95ee\u9898\u8bf7\u5230Issue\u63d0\u4ea4\uff0c\u611f\u8c22\u5404\u4f4d\u6307\u6559\uff01</p>"},{"location":"%E7%AC%94%E8%AE%B0/%E5%89%8D%E7%BD%AE%E7%9F%A5%E8%AF%86/%E5%85%B3%E9%97%AD%E8%BE%93%E5%85%A5%E8%BE%93%E5%87%BA%E6%B5%81/","title":"\u5173\u95ed\u8f93\u5165\u8f93\u51fa\u6d41","text":""},{"location":"%E7%AC%94%E8%AE%B0/%E5%89%8D%E7%BD%AE%E7%9F%A5%E8%AF%86/%E5%85%B3%E9%97%AD%E8%BE%93%E5%85%A5%E8%BE%93%E5%87%BA%E6%B5%81/#_2","title":"\u4ecb\u7ecd","text":"<p>\u5728CSP-J/S\u7b49\u7ade\u8d5b\u4e2d\uff0c\u65f6\u95f4\u9650\u5236\u662f\u6781\u4e3a\u4e25\u683c\u7684\u3002\u56e0\u6b64\uff0c\u9009\u624b\u4e0d\u4ec5\u9700\u8981\u6ce8\u610f\u4ee3\u7801\u7684\u65f6\u95f4\u590d\u6742\u5ea6\uff0c\u8fd8\u9700\u8981\u6ce8\u610f\u7a0b\u5e8f\u7684\u8bfb\u5165\u8f93\u51fa\u6548\u7387\u3002</p> <p>\u6709\u65f6\uff0c\u4f60\u4f1a\u53d1\u73b0<code>cin</code>\u4e0e<code>cout</code>\u7684\u6548\u7387\u592a\u4f4e\uff0c\u5927\u90e8\u5206\u539f\u56e0\u662f\u56e0\u4e3a\u8f93\u5165\u8f93\u51fa\u7684\u540c\u6b65\u6d41\u6ca1\u6709\u5173\u95ed\uff0c\u56e0\u6b64\u624d\u9020\u6210\u4e86<code>TLE</code>\u3002</p> <p>\u6240\u4ee5\u6211\u5728\u8fd9\u91cc\u63d0\u4f9b\u4e24\u79cd\u89e3\u51b3\u65b9\u6848\uff1a</p> <ol> <li> <p>\u5173\u95ed\u8f93\u5165\u8f93\u51fa\u6d41\u3002</p> </li> <li> <p>\u4f7f\u7528<code>scanf</code>\u6216<code>printf</code>\u3002</p> </li> </ol> <p>\u5728\u67d0\u4e9b\u7279\u6b8a\u60c5\u51b5\u4e0b\uff0c\u5173\u95ed\u8f93\u5165\u8f93\u51fa\u6d41\u4f1a\u8f83\u5feb\u4e8e<code>scanf</code>\u4e0e<code>printf</code>\u3002</p> <p>\u4eca\u5929\u6211\u4eec\u5148\u4ecb\u7ecd\u7b2c1\u79cd\u65b9\u6cd5\u3002</p>"},{"location":"%E7%AC%94%E8%AE%B0/%E5%89%8D%E7%BD%AE%E7%9F%A5%E8%AF%86/%E5%85%B3%E9%97%AD%E8%BE%93%E5%85%A5%E8%BE%93%E5%87%BA%E6%B5%81/#_3","title":"\u4f7f\u7528\u65b9\u6cd5","text":"<p>\u5173\u95ed\u8f93\u5165\u8f93\u51fa\u6d41\u5171\u6709\u4e24\u90e8\u5206\u7ec4\u6210\uff1a</p> <ol> <li> <p><code>ios::sync_with_stdio(0)</code></p> </li> <li> <p><code>cin.tie(0)</code>\u4e0e<code>cout.tie(0)</code></p> </li> </ol> <p>\u4e24\u90e8\u5206\u7684\u4f4d\u7f6e\u5728\u4e3b\u51fd\u6570\u4e2d\u4ec5\u6b21\u4e8e<code>freopen()</code>\u7684\u4f4d\u7f6e\uff0c\u6211\u4eec\u62ffA+B Problem\u4e3e\u4f8b\uff1a</p> <pre><code>#include&lt;bits/stdc++.h&gt;\nusing namespace std;\nint main(){\n    freopen(\"xxx.in\",\"r\",stdin);\n    freopen(\"xxx.out\",\"w\",stdout);\n    ios::sync_with_stdio(0);\n    cin.tie(0);\n    cout.tie(0);\n    //\u4f60\u7684\u4ee3\u7801\n    return 0;\n}\n</code></pre> <p>\u5173\u4e8e<code>freopen()</code>\u7684\u4ecb\u7ecd\u8bf7\u770b\u8fd9\u7bc7\u6587\u7ae0</p> <p>\u672c\u6587\u8f83\u77ed\uff0c\u82e5\u6709\u95ee\u9898\u8bf7\u5230Issue\u63d0\u4ea4\uff0c\u611f\u8c22\u5404\u4f4d\u6307\u6559\uff01</p>"},{"location":"%E7%AC%94%E8%AE%B0/%E7%90%86%E8%AE%BA/%E6%97%B6%E9%97%B4%E4%B8%8E%E7%A9%BA%E9%97%B4%E5%A4%8D%E6%9D%82%E5%BA%A6/","title":"\u65f6\u95f4/\u7a7a\u95f4\u590d\u6742\u5ea6","text":""},{"location":"%E7%AC%94%E8%AE%B0/%E7%90%86%E8%AE%BA/%E6%97%B6%E9%97%B4%E4%B8%8E%E7%A9%BA%E9%97%B4%E5%A4%8D%E6%9D%82%E5%BA%A6/#_2","title":"\u7b80\u4ecb","text":"<p>\u65f6\u95f4/\u7a7a\u95f4\u590d\u6742\u5ea6\u662f\u8bc4\u5224\u4ee3\u7801\u662f\u5426\u80fd\u901a\u8fc7\u67d0\u4e2a\u6d4b\u8bd5\u70b9\u7684\u91cd\u8981\u6839\u636e\uff0c\u540c\u65f6\u4e5f\u662f\u9009\u624b\u6839\u636e\u81ea\u5df1\u5199\u7684\u4ee3\u7801\u6765\u5224\u65ad\u81ea\u5df1\u5927\u7ea6\u80fd\u591f\u901a\u8fc7\u591a\u5c11\u4e2a\u6d4b\u8bd5\u70b9\u7684\u68c0\u67e5\u6807\u51c6\u3002</p>"},{"location":"%E7%AC%94%E8%AE%B0/%E7%90%86%E8%AE%BA/%E6%97%B6%E9%97%B4%E4%B8%8E%E7%A9%BA%E9%97%B4%E5%A4%8D%E6%9D%82%E5%BA%A6/#_3","title":"\u6982\u5ff5","text":"<p>\u65f6\u95f4/\u7a7a\u95f4\u590d\u6742\u5ea6\u901a\u5e38\u7528 $O$ \u8868\u793a\uff0c\u4f8b\u5982\u4e00\u4e2a<code>for(int i=1;i&lt;=n;i++)</code>\u7684\u65f6\u95f4\u590d\u6742\u5ea6\u5c31\u662f $O(n)$ \uff0c\u7a7a\u95f4\u590d\u6742\u5ea6\u5c31\u662f $O(1)$ \u3002</p>"},{"location":"%E7%AC%94%E8%AE%B0/%E7%90%86%E8%AE%BA/%E6%97%B6%E9%97%B4%E4%B8%8E%E7%A9%BA%E9%97%B4%E5%A4%8D%E6%9D%82%E5%BA%A6/#_4","title":"\u5173\u4e8e\u5faa\u73af","text":"<p>\u5728\u4e00\u822c\u4ee3\u7801\u4e2d\uff0c\u65f6\u95f4\u590d\u6742\u5ea6\u4e00\u822c\u662f\u770b\u4ee3\u7801\u4e2d\u7684\u5faa\u73af\u800c\u5b9a\u7684\uff0c\u7a7a\u95f4\u590d\u6742\u5ea6\u4e00\u822c\u662f\u770b\u4ee3\u7801\u4e2d\u6570\u7ec4\u7684\u5927\u5c0f\u800c\u5b9a\u7684\u3002</p> <p>\u4f8b\u5982\uff1a</p> <pre><code>#include&lt;bits/stdc++.h&gt;\nusing namespace std;\nint a[10005];\nint main(){\n    ios::sync_with_stdio(0);\n    cin.tie(0);\n    cout.tie(0);\n    int n;\n    cin&gt;&gt;n;\n    for(int i=1;i&lt;=n;i++){\n        cin&gt;&gt;a[i];\n    }\n    reverse(a+1,a+n+1);\n    for(int i=1;i&lt;=n;i++){\n        cout&lt;&lt;a[i]&lt;&lt;' ';\n    }\n    return 0;\n}\n</code></pre> <p>\u5176\u4e2d\uff1a</p> <p><code>a[10005]</code>\u7684\u7a7a\u95f4\u590d\u6742\u5ea6\u662f $O(n)$\uff0c\u65f6\u95f4\u590d\u6742\u5ea6\u662f $O(1)$ \u3002</p> <p>L10~L12\u7684\u8f93\u5165\u4ee3\u7801\u7684\u65f6\u95f4\u590d\u6742\u5ea6\u662f $O(n)$ \u3002</p> <p><code>reverse(a+1,a+n+1)</code>\u7684\u65f6\u95f4\u590d\u6742\u5ea6\u662f $O(n)$ \u3002</p> <p>L14~L15\u7684\u8f93\u51fa\u4ee3\u7801\u7684\u65f6\u95f4\u590d\u6742\u5ea6\u662f $O(n)$ \u3002</p> <p>\u56e0\u6b64\uff0c\u8fd9\u6bb5\u4ee3\u7801\u7684\u65f6\u95f4\u590d\u6742\u5ea6\u662f $O(3n)$ \uff0c\u7a7a\u95f4\u590d\u6742\u5ea6\u662f $O(n)$ \u3002</p> <p>\u672c\u6587\u8f83\u77ed\uff0c\u82e5\u6709\u95ee\u9898\u8bf7\u5230Issue\u63d0\u4ea4\uff0c\u611f\u8c22\u5404\u4f4d\u6307\u6559\uff01</p>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E5%B9%B8%E8%BF%90%E5%8F%B7%E7%A0%81%EF%BC%88lucky%EF%BC%89/","title":"\u5e78\u8fd0\u53f7\u7801\uff08lucky\uff09\u9898\u89e3","text":""},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E5%B9%B8%E8%BF%90%E5%8F%B7%E7%A0%81%EF%BC%88lucky%EF%BC%89/#_1","title":"\u3010\u9898\u76ee\u63cf\u8ff0\u3011","text":"<p>\u5c0f L \u559c\u6b22\u6536\u96c6\u201c\u5e78\u8fd0\u53f7\u7801\u201d\u3002\u4ed6\u5b9a\u4e49\u4e00\u4e2a\u6b63\u6574\u6570 $x$ \u662f\u5e78\u8fd0\u53f7\u7801\uff0c\u5f53\u4e14\u4ec5\u5f53\u540c\u65f6\u6ee1\u8db3\uff1a</p> <ol> <li>$x$ \u7684\u5341\u8fdb\u5236\u8868\u793a\u4e2d\u4e0d\u542b\u6709\u6570\u5b57 $4$\uff1b</li> <li>$x$ \u7684\u5404\u4f4d\u6570\u5b57\u4e4b\u548c\u662f $3$ \u7684\u500d\u6570\u3002</li> </ol> <p>\u4f8b\u5982 $12$ \u662f\u5e78\u8fd0\u53f7\u7801\uff08\u4e0d\u542b $4$\uff0c\u4e14 $1+2=3$ \u662f $3$ \u7684\u500d\u6570\uff09\uff0c\u800c $24$ \u4e0d\u662f\u5e78\u8fd0\u53f7\u7801\uff08\u542b\u6709\u6570\u5b57 $4$\uff09\uff0c$5$ \u4e5f\u4e0d\u662f\u5e78\u8fd0\u53f7\u7801\uff08$5$ \u4e0d\u662f $3$ \u7684\u500d\u6570\uff09\u3002</p> <p>\u73b0\u5728\u7ed9\u5b9a\u4e24\u4e2a\u6b63\u6574\u6570 $L$ , $R$\uff0c\u8bf7\u4f60\u5e2e\u5c0f L \u8ba1\u7b97\uff1a\u5728 $L\u223cR$ \u4e2d\uff08\u5305\u542b $L$ \u548c $R$\uff09\u4e00\u5171\u6709\u591a\u5c11\u4e2a\u5e78\u8fd0\u53f7\u7801\u3002 \u3010\u8f93\u5165\u683c\u5f0f\u3011</p> <p>\u4ece\u6587\u4ef6 $lucky.in$ \u4e2d\u8bfb\u5165\u6570\u636e\u3002</p> <p>\u4e00\u884c\u5305\u542b\u4e24\u4e2a\u6b63\u6574\u6570 $L$ , $R$\uff0c\u7528\u4e00\u4e2a\u7a7a\u683c\u5206\u9694\u3002</p>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E5%B9%B8%E8%BF%90%E5%8F%B7%E7%A0%81%EF%BC%88lucky%EF%BC%89/#_2","title":"\u3010\u8f93\u51fa\u683c\u5f0f\u3011","text":"<p>\u8f93\u51fa\u5230\u6587\u4ef6 $lucky.out$ \u4e2d\u3002</p> <p>\u8f93\u51fa\u4e00\u884c\u5305\u542b\u4e00\u4e2a\u6574\u6570\uff0c\u8868\u793a $L\u223cR$ \u4e2d\u5e78\u8fd0\u53f7\u7801\u7684\u6570\u91cf\u3002 \u3010\u6837\u4f8b 1 \u8f93\u5165\u3011</p> <pre><code>1 30\n</code></pre>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E5%B9%B8%E8%BF%90%E5%8F%B7%E7%A0%81%EF%BC%88lucky%EF%BC%89/#1","title":"\u3010\u6837\u4f8b 1 \u8f93\u51fa\u3011","text":"<pre><code>9\n</code></pre>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E5%B9%B8%E8%BF%90%E5%8F%B7%E7%A0%81%EF%BC%88lucky%EF%BC%89/#1_1","title":"\u3010\u6837\u4f8b 1 \u89e3\u91ca\u3011","text":"<p>1\u223c30 \u4e2d\u7684\u5e78\u8fd0\u53f7\u7801\u4e3a 3, 6, 9, 12, 15, 18, 21, 27, 30\uff0c\u5171 9 \u4e2a\u3002\u6ce8\u610f 24 \u7684\u5404\u4f4d\u6570\u5b57\u4e4b\u548c 2+4=6 \u662f 3 \u7684\u500d\u6570\uff0c\u4f46 24 \u542b\u6709\u6570\u5b57 4\uff0c\u56e0\u6b64\u4e0d\u662f\u5e78\u8fd0\u53f7\u7801\u3002</p>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E5%B9%B8%E8%BF%90%E5%8F%B7%E7%A0%81%EF%BC%88lucky%EF%BC%89/#2","title":"\u3010\u6837\u4f8b 2 \u8f93\u5165\u3