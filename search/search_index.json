02</li> <li>\u996e\u6599\uff1a\u53ea\u80fd\u7528\u9ad8\u7ea7\u5e01\u652f\u4ed8\uff0c\u627e\u96f6\u4e3a\u666e\u901a\u5e01\u3002</li> </ul> <p>\u76ee\u6807\u662f\u4e70\u5c3d\u53ef\u80fd\u591a\u7684\u5546\u54c1\u3002</p>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E8%87%AA%E5%8A%A8%E5%94%AE%E8%B4%A7%E6%9C%BA%EF%BC%88vending%EF%BC%89/#_7","title":"\u6838\u5fc3\u89c2\u5bdf","text":""},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E8%87%AA%E5%8A%A8%E5%94%AE%E8%B4%A7%E6%9C%BA%EF%BC%88vending%EF%BC%89/#1_2","title":"1. \u4e70\u996e\u6599\u7684\u4ee3\u4ef7","text":"<p>\u4e70\u7b2c $j$ \u79cd\u996e\u6599\u4ef7\u683c $B_j$\uff0c\u5fc5\u987b\u7528\u9ad8\u7ea7\u5e01\u652f\u4ed8\u3002\u5047\u8bbe\u7528\u4e86 $c = \\lceil B_j / K \\rceil$ \u679a\u9ad8\u7ea7\u5e01\uff0c\u627e\u96f6 $cK - B_j$ \u5143\u666e\u901a\u5e01\u3002</p> <p>\u6240\u4ee5\u4e70\u4e00\u79cd\u996e\u6599\u7684\u51c0\u4ee3\u4ef7\uff1a</p> <ul> <li>\u6d88\u8017\u9ad8\u7ea7\u5e01 $\\lceil B_j / K \\rceil$ \u679a</li> <li>\u53cd\u800c\u589e\u52a0\u666e\u901a\u5e01 $cK - B_j$ \u5143</li> </ul>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E8%87%AA%E5%8A%A8%E5%94%AE%E8%B4%A7%E6%9C%BA%EF%BC%88vending%EF%BC%89/#2_3","title":"2. \u4e70\u96f6\u98df\u7684\u4ee3\u4ef7","text":"<p>\u96f6\u98df\u53ef\u4ee5\u7528\u666e\u901a\u5e01\u76f4\u63a5\u4e70\uff0c\u4e5f\u53ef\u4ee5\u7528\u9ad8\u7ea7\u5e01\u652f\u4ed8\u540e\u627e\u96f6\u3002\u56e0\u4e3a\u666e\u901a\u5e01\u548c\u9ad8\u7ea7\u5e01\u4e4b\u95f4\u7684\"\u6c47\u7387\"\u662f $1$ \u9ad8\u7ea7\u5e01 $= K$ \u666e\u901a\u5e01\uff0c\u6240\u4ee5\u53ea\u8981\u603b\u8d44\u4ea7\u591f\u5c31\u80fd\u4e70\u3002\u56e0\u6b64\u96f6\u98df\u53ea\u9700\u8981\u6309\u4ef7\u683c\u4ece\u5c0f\u5230\u5927\u6392\u5e8f\uff0c\u80fd\u7528\u94b1\u4e70\u5c31\u4e70\u3002</p>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E8%87%AA%E5%8A%A8%E5%94%AE%E8%B4%A7%E6%9C%BA%EF%BC%88vending%EF%BC%89/#3_2","title":"3. \u8d2a\u5fc3\u7b56\u7565","text":"<p>\u679a\u4e3e\u4e70\u591a\u5c11\u79cd\u996e\u6599\uff08\u4e00\u5b9a\u662f\u4e70\u6700\u4fbf\u5b9c\u7684 $i$ \u79cd\uff0c\u56e0\u4e3a\u6bcf\u79cd\u996e\u6599\u7684\"\u9ad8\u7ea7\u5e01\u6d88\u8017\"\u548c\"\u666e\u901a\u5e01\u8fd4\u8fd8\"\u90fd\u662f\u56fa\u5b9a\u7684\uff0c\u8d8a\u4fbf\u5b9c\u7684\u7ec4\u5408\u8d8a\u7701\u9ad8\u7ea7\u5e01\uff09\u3002</p> <p>\u5bf9\u6bcf\u79cd $i$\uff1a</p> <ul> <li>\u8ba1\u7b97\u524d $i$ \u79cd\u996e\u6599\u6d88\u8017\u7684\u9ad8\u7ea7\u5e01\u603b\u6570 $gj$ \u548c\u8fd4\u8fd8\u7684\u666e\u901a\u5e01\u603b\u6570 $zl$\u3002</li> <li>\u5982\u679c $gj &gt; Y$\uff0c\u8bf4\u660e\u4e70\u4e0d\u8d77\u4e86\uff0c\u76f4\u63a5\u9000\u51fa\u3002</li> <li>\u5269\u4f59\u9ad8\u7ea7\u5e01 $sygj = Y - gj$\uff0c\u5269\u4f59\u666e\u901a\u5e01 $sypt = X + zl$\u3002</li> <li>\u628a\u8fd9\u4e9b\u9ad8\u7ea7\u5e01\u5168\u90e8\u6362\u6210\u666e\u901a\u5e01\uff1a\u603b\u94b1\u6570 $= sypt + sygj \\times K$\u3002</li> <li>\u7528\u8fd9\u4e9b\u94b1\u4e70\u5c3d\u91cf\u591a\u7684\u96f6\u98df\uff08\u524d\u7f00\u548c + \u4e8c\u5206\uff09\u3002</li> <li>\u66f4\u65b0\u7b54\u6848\u3002</li> </ul> <p>\u4ee3\u7801\u5982\u4e0b\uff1a</p> <pre><code>#include&lt;bits/stdc++.h&gt;\n#define ll long long\nusing namespace std;\nll n,m,k;\nll pt,gj;\nll x,y;\nll a[(int)2e5+5],b[(int)2e5+5];\nll sum[(int)2e5+5];\nint main(){\n    freopen(\"vending.in\",\"r\",stdin);\n    freopen(\"vending.out\",\"w\",stdout);\n    ios::sync_with_stdio(0);\n    cin.tie(0);\n    cout.tie(0);\n    cin&gt;&gt;n&gt;&gt;m&gt;&gt;k;\n    cin&gt;&gt;x&gt;&gt;y;\n    for(int i=1;i&lt;=n;i++){\n        cin&gt;&gt;a[i];\n    }\n    sort(a+1,a+n+1);\n    for(int i=1;i&lt;=m;i++){\n        cin&gt;&gt;b[i];\n    }\n    sort(b+1,b+m+1);\n    for(int i=1;i&lt;=n;i++){\n        sum[i]=sum[i-1]+a[i];\n    }\n    ll ans=0;\n    ll gj=0;\n    ll zl=0;\n    for(int i=0;i&lt;=m;i++){\n        if(i&gt;0){\n            ll need=(b[i]+k-1)/k;\n            ll zl_=need*k-b[i];\n            gj+=need;\n            zl+=zl_;\n        }\n        if(gj&gt;y) break;\n        ll sygj=y-gj;\n        ll sypt=x+zl;\n        ll pos1=sypt+sygj*k;\n        ll pos=upper_bound(sum,sum+n+1,pos1)-sum;\n        pos--;\n        ans=max(ans,(ll)i+pos);\n    }\n    cout&lt;&lt;ans&lt;&lt;endl;\n    return 0;\n}\n</code></pre>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E9%A3%9F%E5%A0%82%E6%89%93%E9%A5%AD%EF%BC%88canteen%EF%BC%89/","title":"\u98df\u5802\u6253\u996d\uff08canteen\uff09","text":"<p>\u98df\u5802\u6709 (m) \u4e2a\u6253\u996d\u7a97\u53e3\uff0c\u4ece\u5de6\u5230\u53f3\u4f9d\u6b21\u7f16\u53f7\u4e3a $1 \\sim m$\u3002\u5f00\u996d\u524d\uff0c$n$ \u4e2a\u540c\u5b66\u5df2\u7ecf\u6309\u987a\u5e8f\u6392\u597d\u961f\uff08\u987a\u5e8f\u4e3a $1,2,\\dots,n$\uff09\uff0c\u5728\u65f6\u523b 0 \u65f6\u6240\u6709 $m$ \u4e2a\u7a97\u53e3\u90fd\u7a7a\u95f2\u3002</p> <p>\u7b2c $i$ \u4e2a\u540c\u5b66\u6253\u996d\u9700\u8981 $t_i$ \u5206\u949f\u3002\u6253\u996d\u8fc7\u7a0b\u6309\u4e0b\u9762\u7684\u89c4\u5219\u8fdb\u884c\uff1a</p> <ul> <li>\u5f53\u6709\u7a97\u53e3\u7a7a\u95f2\u65f6\uff0c\u6392\u961f\u6700\u524d\u9762\u7684\u540c\u5b66\u7acb\u5373\u5230\u8be5\u7a97\u53e3\u5f00\u59cb\u6253\u996d\uff0c\u6253\u996d\u5f00\u59cb\u7684\u65f6\u523b\u5c31\u662f\u8be5\u7a97\u53e3\u7a7a\u95f2\u7684\u65f6\u523b\uff1b</li> <li>\u5982\u679c\u540c\u4e00\u65f6\u523b\u6709\u591a\u4e2a\u7a97\u53e3\u7a7a\u95f2\uff0c\u8fd9\u4e9b\u540c\u5b66\u6309\u7a97\u53e3\u7f16\u53f7\u4ece\u5c0f\u5230\u5927\u4f9d\u6b21\u5b89\u6392\uff08\u540c\u5b66\u7684\u6392\u961f\u987a\u5e8f\u4e0d\u53d8\uff0c\u961f\u4f0d\u6700\u524d\u9762\u7684\u540c\u5b66\u603b\u662f\u4f18\u5148\uff09\uff1b</li> <li>\u540c\u5b66 $i$ \u5728\u65f6\u523b $s_i$ \u5f00\u59cb\u6253\u996d\uff0c\u5219\u5728\u65f6\u523b $s_i+t_i$ \u6253\u5b8c\u5e76\u7acb\u5373\u79bb\u5f00\uff0c\u8be5\u7a97\u53e3\u968f\u4e4b\u7a7a\u95f2\uff1b</li> <li>\u6bcf\u4e2a\u7a97\u53e3\u540c\u4e00\u65f6\u523b\u53ea\u80fd\u670d\u52a1\u4e00\u540d\u540c\u5b66\uff0c\u6bcf\u540d\u540c\u5b66\u53ea\u6253\u4e00\u6b21\u996d\u3002</li> </ul> <p>\u8bf7\u4f60\u8ba1\u7b97\uff1a\u6240\u6709\u540c\u5b66\u6253\u5b8c\u996d\u7684\u65f6\u523b\u4e4b\u548c\uff0c\u4ee5\u53ca\u6700\u540e\u4e00\u4e2a\u540c\u5b66\u6253\u5b8c\u996d\u7684\u65f6\u523b\u3002</p>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E9%A3%9F%E5%A0%82%E6%89%93%E9%A5%AD%EF%BC%88canteen%EF%BC%89/#_1","title":"\u8f93\u5165\u683c\u5f0f","text":"<p>\u4ece\u6587\u4ef6 $canteen.in$ \u4e2d\u8bfb\u5165\u6570\u636e\u3002</p> <p>\u7b2c\u4e00\u884c\u5305\u542b\u4e24\u4e2a\u6b63\u6574\u6570 $n,m$\uff0c\u5206\u522b\u8868\u793a\u540c\u5b66\u6570\u548c\u7a97\u53e3\u6570\u3002</p> <p>\u7b2c\u4e8c\u884c\u5305\u542b $n$ \u4e2a\u6b63\u6574\u6570 $t_1,t_2,\\dots,t_n$\uff0c\u76f8\u90bb\u6574\u6570\u4e4b\u95f4\u4ee5\u5355\u4e2a\u7a7a\u683c\u5206\u9694\uff0c\u4f9d\u6b21\u8868\u793a\u6bcf\u4e2a\u540c\u5b66\u6253\u996d\u9700\u8981\u7684\u65f6\u95f4\u3002</p>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E9%A3%9F%E5%A0%82%E6%89%93%E9%A5%AD%EF%BC%88canteen%EF%BC%89/#_2","title":"\u8f93\u51fa\u683c\u5f0f","text":"<p>\u8f93\u51fa\u5230\u6587\u4ef6 $canteen.out$ \u4e2d\u3002</p> <p>\u8f93\u51fa\u4e00\u884c\u5305\u542b\u4e24\u4e2a\u6574\u6570\uff0c\u7528\u4e00\u4e2a\u7a7a\u683c\u5206\u9694\uff0c\u5206\u522b\u8868\u793a\u6240\u6709\u540c\u5b66\u6253\u5b8c\u996d\u7684\u65f6\u523b\u4e4b\u548c\u3001\u6700\u540e\u4e00\u4e2a\u540c\u5b66\u6253\u5b8c\u996d\u7684\u65f6\u523b\u3002</p> <p>\u6ce8\u610f\uff1a\u8fd9\u4e24\u4e2a\u6574\u6570\u90fd\u53ef\u80fd\u8d85\u8fc7 32 \u4f4d\u6709\u7b26\u53f7\u6574\u6570\u7684\u8868\u793a\u8303\u56f4\u3002 \u3010\u6837\u4f8b 1 \u8f93\u5165\u3011</p> <pre><code>5 2\n3 2 4 1 1\n</code></pre>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E9%A3%9F%E5%A0%82%E6%89%93%E9%A5%AD%EF%BC%88canteen%EF%BC%89/#1","title":"\u3010\u6837\u4f8b 1 \u8f93\u51fa\u3011","text":"<pre><code>20 6\n</code></pre>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E9%A3%9F%E5%A0%82%E6%89%93%E9%A5%AD%EF%BC%88canteen%EF%BC%89/#1_1","title":"\u3010\u6837\u4f8b 1 \u89e3\u91ca\u3011","text":"<ul> <li>\u65f6\u523b 0\uff1a2 \u4e2a\u7a97\u53e3\u90fd\u7a7a\u95f2\uff0c1 \u53f7\u540c\u5b66\u5230 1 \u53f7\u7a97\u53e3\uff08\u7528\u65f6 3\uff0c\u5b8c\u6210\u4e8e\u65f6\u523b 3\uff09\uff0c2 \u53f7\u540c\u5b66\u5230 2 \u53f7\u7a97\u53e3\uff08\u7528\u65f6 2\uff0c\u5b8c\u6210\u4e8e\u65f6\u523b 2\uff09\uff1b</li> <li>\u65f6\u523b 2\uff1a2 \u53f7\u7a97\u53e3\u7a7a\u95f2\uff0c3 \u53f7\u540c\u5b66\u5230 2 \u53f7\u7a97\u53e3\uff08\u7528\u65f6 4\uff0c\u5b8c\u6210\u4e8e\u65f6\u523b 6\uff09\uff1b</li> <li>\u65f6\u523b 3\uff1a1 \u53f7\u7a97\u53e3\u7a7a\u95f2\uff0c4 \u53f7\u540c\u5b66\u5230 1 \u53f7\u7a97\u53e3\uff08\u7528\u65f6 1\uff0c\u5b8c\u6210\u4e8e\u65f6\u523b 4\uff09\uff1b</li> <li>\u65f6\u523b 4\uff1a1 \u53f7\u7a97\u53e3\u7a7a\u95f2\uff0c5 \u53f7\u540c\u5b66\u5230 1 \u53f7\u7a97\u53e3\uff08\u7528\u65f6 1\uff0c\u5b8c\u6210\u4e8e\u65f6\u523b 5\uff09\u3002</li> </ul> <p>\u6240\u6709\u540c\u5b66\u5b8c\u6210\u65f6\u523b\u4e4b\u548c\u4e3a 3+2+6+4+5=20\uff0c\u6700\u540e\u4e00\u4e2a\u540c\u5b66\u5b8c\u6210\u4e8e\u65f6\u523b 6\u3002 \u3010\u6837\u4f8b 2 \u8f93\u5165\u3011</p> <pre><code>3 5\n10 20 30\n</code></pre>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E9%A3%9F%E5%A0%82%E6%89%93%E9%A5%AD%EF%BC%88canteen%EF%BC%89/#2","title":"\u3010\u6837\u4f8b 2 \u8f93\u51fa\u3011","text":"<pre><code>60 30\n</code></pre>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E9%A3%9F%E5%A0%82%E6%89%93%E9%A5%AD%EF%BC%88canteen%EF%BC%89/#2_1","title":"\u3010\u6837\u4f8b 2 \u89e3\u91ca\u3011","text":"<p>\u7a97\u53e3\u6570\u591a\u4e8e\u540c\u5b66\u6570\uff0c\u4e09\u4f4d\u540c\u5b66\u5728\u65f6\u523b 0 \u540c\u65f6\u7a7a\u95f2\u7684\u7a97\u53e3\u4e2d\u6309\u7f16\u53f7\u4ece\u5c0f\u5230\u5927\u5206\u522b\u5230 1, 2, 3 \u53f7\u7a97\u53e3\uff0c\u5b8c\u6210\u65f6\u523b\u4f9d\u6b21\u4e3a 10, 20, 30\uff0c\u4e4b\u548c\u4e3a 60\u3002</p>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E9%A3%9F%E5%A0%82%E6%89%93%E9%A5%AD%EF%BC%88canteen%EF%BC%89/#3","title":"\u3010\u6837\u4f8b 3 \u8f93\u5165\u3011","text":"<pre><code>4 1\n5 5 5 5\n</code></pre>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E9%A3%9F%E5%A0%82%E6%89%93%E9%A5%AD%EF%BC%88canteen%EF%BC%89/#3_1","title":"\u3010\u6837\u4f8b 3 \u8f93\u51fa\u3011","text":"<pre><code>50 20\n</code></pre>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E9%A3%9F%E5%A0%82%E6%89%93%E9%A5%AD%EF%BC%88canteen%EF%BC%89/#3_2","title":"\u3010\u6837\u4f8b 3 \u89e3\u91ca\u3011","text":"<p>\u53ea\u6709 1 \u4e2a\u7a97\u53e3\uff0c\u56db\u4f4d\u540c\u5b66\u53ea\u80fd\u4f9d\u6b21\u6253\u996d\uff0c\u5b8c\u6210\u65f6\u523b\u4f9d\u6b21\u4e3a 5, 10, 15, 20\uff0c\u4e4b\u548c\u4e3a 50\uff0c\u6700\u540e\u4e00\u4e2a\u540c\u5b66\u5b8c\u6210\u4e8e\u65f6\u523b 20\u3002</p>"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E9%A3%9F%E5%A0%82%E6%89%93%E9%A5%AD%EF%BC%88canteen%EF%BC%89/#_3","title":"\u3010\u6570\u636e\u8303\u56f4\u3011","text":"<p>\u5bf9\u4e8e\u6240\u6709\u6d4b\u8bd5\u6570\u636e\uff0c\u4fdd\u8bc1\uff1a$1\u2264n\u226410^5\uff0c1\u2264m\u226410^5\uff0c1\u2264t_i\u200b\u226410^6$\u3002</p> \u6d4b\u8bd5\u70b9 $n$ \u7279\u6b8a\u6027\u8d28 $1\u223c3$ $\\leq50$ \u65e0\u7279\u6b8a\u6027\u8d28 $4\u223c6$ $\\leq10^3$ \u65e0\u7279\u6b8a\u6027\u8d28 $7\u223c8$ $\\leq10^5$ $m=1$ $9\u223c10$ $\\leq10^5$ \u65e0\u7279\u6b8a\u6027\u8d28"},{"location":"%E9%A2%98%E8%A7%A3/2026-10-03%20CSP-J%E6%A8%A1%E6%8B%9F%E8%B5%9B%20%E9%A2%98%E8%A7%A3/%E9%A3%9F%E5%A0%82%E6%89%93%E9%A5%AD%EF%BC%88canteen%EF%BC%89/#_4","title":"\u3010\u9898\u89e3\u3011","text":"<p>\u89c2\u5bdf\u53ef\u5f97\uff0c$n_{max} \\leq 10^5$ \uff0c\u56e0\u6b64\u6211\u4eec\u53ef\u4ee5\u5c06\u65f6\u95f4\u590d\u6742\u5ea6\u7ef4\u6301\u5728 $O(n)$ \u5de6\u53f3\u5373\u53ef\uff0c\u6240\u4ee5\u6211\u4eec\u5e76\u4e0d\u80fd\u76f4\u63a5\u6a21\u62df\u6bcf\u4e2a\u65f6\u523b\uff0c\u89c2\u5bdf\u5f97\uff1a\u6bcf\u4e2a\u7a97\u53e3\u7684\u4e0b\u4e00\u6b21\u7a7a\u95f2\u65f6\u523b\u5c31\u662f\u5f53\u524d\u6392\u961f\u6700\u524d\u9762\u7684\u540c\u5b66\u6253\u996d\u5f00\u59cb\u7684\u65f6\u523b\u3002\u56e0\u6b64\u6211\u4eec\u53ea\u9700\u8981\u7ef4\u62a4\u6bcf\u4e2a\u7a97\u53e3\u5f53\u524d\u53d8\u4e3a\u7a7a\u95f2\u7684\u65f6\u523b\u3002\u6bcf\u5f53\u6709\u4e00\u4e2a\u540c\u5b66\u8981\u6253\u996d\u65f6\uff0c\u9009\u62e9\u6700\u65e9\u7a7a\u95f2\u7684\u7a97\u53e3\uff0c\u8be5\u540c\u5b66\u5728\u8fd9\u4e2a\u65f6\u523b\u5f00\u59cb\u6253\u996d\uff0c$\u5b8c\u6210\u65f6\u523b=\u7a97\u53e3\u7a7a\u95f2\u65f6\u523b+t_i$ \u3002\u7136\u540e\u628a\u8be5\u7a97\u53e3\u7684\u4e0b\u4e00\u6b21\u7a7a\u95f2\u65f6\u523b\u66f4\u65b0\u4e3a\u8fd9\u4e2a\u5b8c\u6210\u65f6\u523b\uff0c\u653e\u56de\u961f\u5217\u4e2d\u3002</p> <p>\u7531\u4e8e$n,m\\leq10^5$\uff0c\u9700\u8981\u4e00\u79cd\u80fd\u5feb\u901f\u53bb\u9664\u6700\u5c0f\u503c\u3001\u63d2\u5165\u65b0\u503c\u7684\u6570\u636e\u7ed3\u6784\u2014\u2014\u5c0f\u6839\u9000<code>priority_queue&lt;llmvector&lt;ll&gt;,greater&lt;ll&gt;&gt;</code>\u6b63\u597d\u6ee1\u8db3\uff0c\u5355\u6b21\u64cd\u4f5c $O(\\log{m})$ \uff0c\u603b\u590d\u6742\u5ea6 $O(n\\log{m})$ \uff0c\u5b8c\u5168\u53ef\u4ee5\u901a\u8fc7\u3002 \u7b97\u6cd5\u6d41\u7a0b</p> <ol> <li> <p>\u8bfb\u5165 n,m \u548c\u6bcf\u4e2a\u540c\u5b66\u7684\u6253\u996d\u65f6\u95f4 ti\u200b\u3002</p> </li> <li> <p>\u521d\u59cb\u5316\u5c0f\u6839\u5806\uff0c\u5c06 m \u4e2a\u7a97\u53e3\u7684\u7a7a\u95f2\u65f6\u523b\u5168\u90e8\u8bbe\u4e3a 0 \u5e76\u538b\u5165\u5806\u4e2d\u3002</p> </li> <li> <p>\u4f9d\u6b21\u5904\u7406\u6bcf\u4e2a\u540c\u5b66\uff1a</p> </li> <li> <p>\u53d6\u51fa\u5806\u9876\u5143\u7d20 <code>pos</code>\uff0c\u8868\u793a\u5f53\u524d\u6700\u65e9\u7a7a\u95f2\u7a97\u53e3\u7684\u7a7a\u95f2\u65f6\u523b\uff1b</p> </li> <li> <p>\u8be5\u540c\u5b66\u4ece <code>pos</code> \u65f6\u523b\u5f00\u59cb\u6253\u996d\uff0c\u5b8c\u6210\u65f6\u523b\u4e3a <code>pos + t_i</code>\uff1b</p> </li> <li> <p>\u7d2f\u52a0\u5b8c\u6210\u65f6\u523b\u5230 <code>sum</code>\uff0c\u5e76\u66f4\u65b0 <code>maxx</code>\uff1b</p> </li> <li> <p>\u5c06\u8be5\u7a97\u53e3\u7684\u4e0b\u4e00\u6b21\u7a7a\u95f2\u65f6\u523b <code>pos + t_i</code> \u538b\u56de\u5806\u4e2d\u3002</p> </li> <li> <p>\u8f93\u51fa <code>sum</code> \u548c <code>maxx</code>\u3002</p> </li> </ol> <p>\u4ee3\u7801\u5982\u4e0b\uff1a</p> <pre><code>#include&lt;bits/stdc++.h&gt;\n#define ll long long\nusing namespace std;\npriority_queue&lt;ll,vector&lt;ll&gt;,greater&lt;ll&gt;&gt;q;\nint n,m;\nint stu[100005];\nint main(){\n    freopen(\"canteen.in\",\"r\",stdin);\n    freopen(\"canteen.out\",\"w\",stdout);\n    ios::sync_with_stdio(0);\n    cin.tie(0);\n    cout.tie(0);\n    cin&gt;&gt;n&gt;&gt;m;\n    for(int i=1;i&lt;=n;i++){\n        cin&gt;&gt;stu[i];\n    }\n    for(int i=1;i&lt;=m;i++){\n        q.push(0);\n    }\n    ll sum=0,maxx=0;\n    for(int i=1;i&lt;=n;i++){\n        ll pos=q.top();\n        q.pop();\n        ll t=pos;\n        ll f=t+stu[i];\n        sum+=f;\n        maxx=max(f,maxx);\n        q.push(f);\n    }\n    cout&lt;&lt;sum&lt;&lt;' '&lt;&lt;maxx&lt;&lt;'\\n';\n    return 0;\n}\n</code></pre>"}]}