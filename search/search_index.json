{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u5173\u4e8e\u672c\u7ad9","text":"<p>\u672c\u7ad9\u4e3a\u6211\u4e2a\u4eba\u7684\u6d1b\u8c37\u9898\u76ee\u9898\u89e3\uff0c\u5e76\u4e14\u6709\u4e00\u4e9b\u57fa\u7840\u7684\u6559\u7a0b\uff0c\u5e0c\u671b\u53ef\u4ee5\u5e2e\u65b0\u624bOIer\u5feb\u901f\u5165\u95e8\u3002</p>"},{"location":"%E7%AC%94%E8%AE%B0/freopen%E7%9A%84%E4%BD%BF%E7%94%A8/","title":"<code>freopen()</code>\u7684\u4f7f\u7528","text":""},{"location":"%E7%AC%94%E8%AE%B0/freopen%E7%9A%84%E4%BD%BF%E7%94%A8/#_1","title":"\u7b80\u4ecb","text":"<p><code>freopen()</code>\u662f\u4e00\u79cd\u6587\u4ef6\u8bfb\u5199\u51fd\u6570\uff0c\u4e3b\u8981\u7528\u4e8eCSP-J/S\u6bd4\u8d5b\uff0c\u672c\u6587\u5c06\u4ecb\u7ecd<code>freopen()</code>\u51fd\u6570\u7684\u4f7f\u7528\u65b9\u6cd5\uff0c\u5e2e\u52a9\u65b0\u624bOIer\u907f\u514d\u56e0\u4e3a\u6587\u4ef6I/O\u683c\u5f0f\u9519\u8bef\u800c\u7206\u96f6\u3002</p>"},{"location":"%E7%AC%94%E8%AE%B0/freopen%E7%9A%84%E4%BD%BF%E7%94%A8/#_2","title":"\u4f7f\u7528\u65b9\u6cd5","text":"<p><code>freopen()</code>\u4e3b\u8981\u7684\u4f7f\u7528\u683c\u5f0f\u662f\uff1a<code>freopen(\u6587\u4ef6\u540d(\u5305\u542b\u540e\u7f00\u540d),\u6a21\u5f0f(r/w),\u5176\u4ed6)</code>\u3002</p> <p>\u4f8b\u5982\u4e00\u4f4d\u9009\u624b\u9700\u8981\u8bfb\u5165<code>apple.in</code>\u4e2d\u7684\u6570\u636e\uff0c\u8f93\u51fa\u5230<code>apple.out</code>\u3002</p> <p>\u90a3\u4e48Ta\u5c31\u53ef\u4ee5\u8fd9\u4e48\u5199\uff1a</p> <pre><code>freopen(\"apple.in\",\"r\",stdin);\nfreopen(\"apple.out\",\"w\",stdout);\n</code></pre> <p>\u5176\u4e2d\uff1a</p> <p><code>apple.in</code>\u4e0e<code>apple.out</code>\u8868\u793a\u9700\u8981\u8bfb\u5165\u4e0e\u8f93\u51fa\u7684\u6587\u4ef6\u540d\u3002</p> <p>$\\textbf{\\red{\u6ce8\u610f\uff1a\u5982\u679c\u6587\u4ef6\u5939\u4e2d\u6ca1\u6709apple.in\u6587\u4ef6\uff0c\u5219\u4f1a\u62a5\u9519\u3002}}$</p> <p><code>r</code>\u8868\u793a\u8bfb\u5165\u6a21\u5f0f\uff0c\u662f<code>read</code>\u7684\u7f29\u5199\uff1b<code>w</code>\u8868\u793a\u8bfb\u51fa\u6a21\u5f0f\uff0c\u662f<code>write</code>\u7684\u7f29\u5199\uff1b</p> <p><code>stdin</code>\u4e0e<code>stdout</code>\u662f\u8bfb\u5165\u4e0e\u8f93\u51fa\u9700\u8981\u7684\u914d\u7f6e\uff0c\u8fd9\u91cc\u4e0d\u9700\u8981\u7ba1\uff0c\u5199\u4e0a\u5c31\u53ef\u4ee5\u4e86\u3002</p> <p>\u6ce8\u610f\uff0c<code>freopen()</code>\u9700\u8981\u5199\u5728\u5173\u95ed\u8f93\u5165\u8f93\u51fa\u6d41\u7684\u524d\u9762\uff0c\u4e5f\u5c31\u662f\u4e3b\u51fd\u6570\u7684\u7b2c\u4e00\u884c\uff0c\u8fd8\u662f\u4ee5apple\u4e3e\u4f8b\uff0c\u5c31\u50cf\u8fd9\u6837\uff1a</p> <pre><code>#include&lt;bits/stdc++.h&gt;\nusing namespace std;\nint main(){\n    freopen(\"apple.in\",\"r\",stdin);\n    freopen(\"apple.out\",\"w\",stdout);\n    ios::sync_with_stdio(0);\n    cin.tie(0);\n    cout.tie(0);\n    //\u4f60\u7684\u4ee3\u7801\n    return 0;\n}\n</code></pre> <p>\u672c\u6587\u8f83\u77ed\uff0c\u82e5\u6709\u95ee\u9898\u8bf7\u5230Issue\u63d0\u4ea4\uff0c\u611f\u8c22\u5404\u4f4d\u6307\u6559\uff01</p>"}]}